  "messages": {
    "stepAnnouncement": "Etapa {current} de {total}.",
    "missingFirstStep": "Escolha {missingFields} para continuar.",
    "missingAnswers": "Escolha {missingFields} para ver as recomendações.",
    "firstStepJoiner": " e ",
    "otherStepsJoiner": ", "
  },
  "recommendation": {
    "eyebrow": "SUA SELEÇÃO",
    "defaultModelId": "flow",
    "titles": {
      "flow": "Seu ponto de partida: triobum fluxo.",
      "pulse": "Seu ponto de partida: triobum pulso."
    },
    "reasons": {
      "flow": "Você busca {goalPhrase}, prefere uma sensação {feelValue} e costuma correr {distancePhrase}. O fluxo prioriza conforto e estabilidade. {budgetMessage}",
      "pulse": "Você quer evoluir, prefere uma sensação responsiva e costuma correr {distancePhrase}. O pulso prioriza leveza e resposta para treinos em que o ritmo sobe. {budgetMessage}"
    },
    "compareAction": {
      "label": "Comparar os dois modelos",
      "icon": "→",
      "href": "#compare"
    },
    "externalAction": {
      "label": "Explorar mais opções",
      "icon": "↗",
      "promptId": "discover.profile",
      "accessibleLabel": "Explorar mais opções — abrir conversa no ChatGPT em nova aba"
    },
    "externalNotice": "Este link abre uma ferramenta de IA em outra aba e inclui as quatro respostas que você escolheu na URL da conversa.",
    "rules": [
      {
        "modelId": "pulse",
        "all": [
          {
            "fieldId": "goal",
            "equals": "improve"
          },
          {
            "fieldId": "feel",
            "equals": "responsive"
          },
          {
            "fieldId": "distance",
            "notEquals": "long"
          }
        ]
      }
    ],
    "reasonBindings": {
      "goalPhrase": {
        "fieldId": "goal",
        "values": {
          "start": "começar a correr",
          "improve": "evoluir com uma base confiável"
        }
      },
      "feelValue": {
        "fieldId": "feel",
        "optionProperty": "label",
        "transform": "lowercase"
      },
      "distancePhrase": {
        "fieldId": "distance",
        "optionProperty": "phrase"
      },
      "budgetMessage": {
        "fieldId": "budget",
        "messages": {
          "unselected": "Você pode definir o orçamento depois de comparar conforto, ajuste e uso.",
          "selected": "Seu orçamento de {budgetValue} ajuda a organizar a busca; os preços destes modelos ainda não estão disponíveis neste protótipo."
        },
        "unselectedOptionId": "undecided",
        "valueProperty": "reasonValue",
        "valueVariable": "budgetValue"
      }
    }
  }
}
