          "display": "tiles",
          "options": [
            {
              "id": "soft",
              "label": "Macia",
              "icon": "☁"
            },
            {
              "id": "balanced",
              "label": "Equilibrada",
              "icon": "◇"
            },
            {
              "id": "responsive",
              "label": "Responsiva",
              "icon": "ϟ"
            },
            {
              "id": "stable",
              "label": "Estável",
              "icon": "⬡"
            }
          ]
        }
      ],
      "nextAction": {
        "label": "Continuar",
        "icon": "→"
      }
    },
    {
