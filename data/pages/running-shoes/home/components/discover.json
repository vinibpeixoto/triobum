            {
              "id": "10k",
              "label": "10 km",
              "icon": "↝",
              "phrase": "10 km"
            },
            {
              "id": "21k",
              "label": "21 km",
              "icon": "◈",
              "phrase": "21 km"
            },
            {
              "id": "long",
              "label": "Longões e maratona",
              "icon": "↗",
              "phrase": "longões"
            }
          ]
