              "reasonValue": "R$ 800 a R$ 1.200"
            },
            {
              "id": "undecided",
              "label": "Ainda não sei",
              "reasonValue": "ainda não sei"
            }
          ]
        }
      ],
      "closingNote": {
        "emphasis": "Pronto. Agora vamos encontrar o tênis que combina com o seu corre.",
        "description": "Suas respostas ajudam a filtrar os modelos que mais fazem sentido para você."
      },
      "backAction": {
        "label": "← Voltar"
      },
      "primaryAction": {
        "label": "Ver minhas recomendações",
        "icon": "→"
      }
